# ==========================================
# Server & Environment Configuration
# ==========================================
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# ==========================================
# Database Connection (MongoDB / MongoDB Atlas)
# ==========================================
# Local development default:
MONGO_URI=mongodb://127.0.0.1:27017/zydoc-app
# MongoDB Atlas (Production / Cloud Cluster):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ==========================================
# Admin Seed Configuration
# ==========================================
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# ==========================================
# JWT Authentication Configuration
# ==========================================
JWT_SECRET=your_super_secret_jwt_key
REFRESH_SECRET=your_super_secret_refresh_key
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# ==========================================
# Email Service (Nodemailer / SMTP)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_specific_password

# ==========================================
# Firebase Admin SDK Configuration
# ==========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Note: Keep the private key wrapped in quotes with literal \n characters
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...your_key_here...\n-----END PRIVATE KEY-----\n"

# ==========================================
# Payment Gateway (Razorpay)
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# AWS & Object Storage Configuration (S3 / CloudFront)
# ==========================================
# Storage driver: 's3' (default, enables AWS S3 + CloudFront) or 'local' (forces local disk uploads/ fallback)
FILE_STORAGE_DRIVER=s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_PUBLIC_BUCKET=your-s3-public-assets-bucket
S3_PRIVATE_BUCKET=your-s3-private-files-bucket
# CloudFront distribution domain for public approved doctor assets (without https:// or trailing slashes)
AWS_CLOUDFRONT_DOMAIN=your-distribution-id.cloudfront.net

