# ==========================================
# Server & Environment Configuration
# ==========================================
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# ==========================================
# Database Connection (MongoDB)
# ==========================================
MONGO_URI=mongodb://127.0.0.1:27017/zydoc-app

# ==========================================
# Admin Seed Configuration
# ==========================================
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# ==========================================
# JWT Authentication Configuration
# ==========================================
JWT_SECRET=your_super_secret_jwt_key
REFRESH_SECRET=your_super_secret_refresh_key
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# ==========================================
# Email Service (Nodemailer / SMTP)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_specific_password

# ==========================================
# Firebase Admin SDK Configuration
# ==========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Note: Keep the private key wrapped in quotes with literal \n characters
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...your_key_here...\n-----END PRIVATE KEY-----\n"

# ==========================================
# Payment Gateway (Razorpay)
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
